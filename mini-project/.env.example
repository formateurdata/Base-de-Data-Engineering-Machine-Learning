# À copier vers .env, puis changer les mots de passe (lettres et chiffres uniquement).
POSTGRES_PASSWORD=changermoi1
LECTEUR_PASSWORD=changermoi2
AIRFLOW_DB_PASSWORD=changermoi3

# Ports de la machine hôte : à changer si l'un d'eux est déjà pris.
PG_PORT=5434
AIRFLOW_PORT=8081
HDFS_UI_PORT=9870
GENERATEUR_PASSWORD=generateurExemple
AIRFLOW_ADMIN_PASSWORD=adminExemple

# Images du cours, publiées par le workflow GitHub Actions.
# Vous pouvez remplacer les tags par une référence @sha256 fournie par l'enseignant.
HADOOP_IMAGE=ghcr.io/formateurdata/bac4-hadoop:3.5.0-1
AIRFLOW_IMAGE=ghcr.io/formateurdata/bac4-airflow:3.3.2-1
