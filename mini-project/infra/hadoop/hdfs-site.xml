<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Un seul DataNode : une seule copie de chaque bloc -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///hadoop/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///hadoop/dfs/data</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- Dans un réseau Docker, le nom inverse d'un conteneur ne correspond pas à son nom de service -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
  <!-- WebHDFS redirige les écritures vers ce nom, connu dans le réseau Compose -->
  <property>
    <name>dfs.datanode.hostname</name>
    <value>datanode</value>
  </property>
</configuration>
